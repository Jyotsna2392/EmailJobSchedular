PORT=5000
NODE_ENV=development

# Database (Prisma SQLite by default for easy local running, or PostgreSQL)
DATABASE_URL="file:./dev.db"

# Redis Config (BullMQ)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
USE_IN_MEMORY_REDIS_FALLBACK=true

# Elasticsearch Config
ELASTICSEARCH_NODE=http://localhost:9200

# Scheduler & Throttling Config
WORKER_CONCURRENCY=5
MIN_SEND_DELAY_MS=2000
DEFAULT_MAX_EMAILS_PER_HOUR=200

# Google OAuth Config
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Slack OAuth / Webhook Integration
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_REDIRECT_URI=http://localhost:5000/api/slack/callback

# Email Provider Configuration ('ethereal' or 'brevo')
EMAIL_PROVIDER=ethereal

# Brevo Transactional Email API Config
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=ReachInbox Scheduler

